# 공증 DMG 배포 자격증명 템플릿.
# 이 파일을 복사해서  fastlane/.env.release  로 저장하고 값을 채우세요.
# (fastlane/.env.release 는 .gitignore되어 커밋되지 않습니다.)
#
# 실행:  fastlane mac release --env release

# 서명 (Developer ID Application 인증서)
CODE_SIGN_STYLE=Manual
CODE_SIGN_IDENTITY=Developer ID Application: YOUR NAME (TEAMID)
DEVELOPMENT_TEAM=YOUR_TEAM_ID

# 공증 (둘 중 하나)
# (A) Apple ID + 앱 암호  ← 가장 간단, 권장
APPLE_ID=you@example.com
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# (B) App Store Connect API key  ← (A) 대신 쓰려면 위 두 줄 지우고 아래 사용
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8
